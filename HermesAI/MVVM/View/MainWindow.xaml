<Window x:Class="HermesAI.MVVM.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:local="clr-namespace:HermesAI"
        x:Name="RootWindow"
        Title="HermesAI" Height="700" Width="1200"
        Background="#343541" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Sidebar button style (transparent, subtle hover) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2B32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#343541"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- New Chat button style (bordered, subtle hover) -->
        <Style x:Key="NewChatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4D4D4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2B32"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#343541"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar close button style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

  <Border CornerRadius="10" Background="#343541" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/> <RowDefinition Height="*"/>  </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#202123">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseLeftButtonDown">
                        <b:InvokeCommandAction Command="{Binding DragWindowCommand}" 
                                               CommandParameter="{Binding ElementName=RootWindow}"/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>

                <TextBlock Text="Hermes AI" Foreground="#D1D5DB" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="13"/>
    
                <Button Content="✕" 
                        HorizontalAlignment="Right" Width="40" FontSize="14"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Command="{Binding CloseWindowCommand}" 
                        CommandParameter="{Binding ElementName=RootWindow}"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/> 
                    <ColumnDefinition Width="*"/>   
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="#202123">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Margin="10,15,10,10" Padding="10" 
                            Style="{StaticResource NewChatButtonStyle}"
                            HorizontalContentAlignment="Left" Command="{Binding NewChatCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" Margin="0,0,10,0" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Neuer Chat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="Heute" Foreground="#8E8EA0" FontSize="11" Margin="5,0,0,5" FontWeight="SemiBold"/>

                            <ItemsControl ItemsSource="{Binding ChatList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Title}" 
                                                Style="{StaticResource SidebarButtonStyle}"
                                                HorizontalContentAlignment="Left" 
                                                Padding="5,8" 
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.SelectChatCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Umbenennen" 
                                                              Command="{Binding PlacementTarget.Tag.RenameChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="Löschen" 
                                                              Command="{Binding PlacementTarget.Tag.DeleteChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#4D4D4F" BorderThickness="0,1,0,0" Padding="15">
                        <StackPanel>
                            <TextBlock Text="{Binding McpStatus}" Foreground="#8E8EA0" Cursor="Hand" Margin="0,0,0,8">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMcpServersCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                            <TextBlock Text="⚙ Einstellungen" Foreground="#D1D5DB" Cursor="Hand">
                                <TextBlock.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}"/>
                                </TextBlock.InputBindings>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Background="#343541">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>    
                        <RowDefinition Height="Auto"/> 
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20" ScrollChanged="ChatScrollViewer_ScrollChanged" PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
    
                        <ItemsControl ItemsSource="{Binding CurrentChat.Messages}" MaxWidth="800">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MessageBorder" 
                                            CornerRadius="8" Padding="15" Margin="0,10,0,10" 
                                            HorizontalAlignment="Left" MaxWidth="650"
                                            Background="#444654">
                
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> 
                                                <ColumnDefinition Width="*"/>    
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="Avatar" Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#10A37F" VerticalAlignment="Top" Margin="0,0,15,0">
                                                <TextBlock Text="H" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </Border>
                    
                                            <markdig:MarkdownViewer Grid.Column="1" 
                                                                Markdown="{Binding Text}" 
                                                                Background="Transparent"
                                                                VerticalAlignment="Center"
                                                                Margin="-5,0,0,0">
    
                                            <markdig:MarkdownViewer.Resources>
                                                <!-- Document-level style -->
                                                <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="PagePadding" Value="0" />
                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                </Style>

                                                <!-- Paragraph style -->
                                                <Style x:Key="{x:Static markdig:Styles.ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Margin" Value="0,0,0,10" />
                                                </Style>

                                                <!-- Heading styles -->
                                                <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontSize" Value="24" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Margin" Value="0,10,0,10" />
                                                </Style>
                                                <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontSize" Value="20" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Margin" Value="0,8,0,8" />
                                                </Style>
                                                <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontSize" Value="18" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Margin" Value="0,6,0,6" />
                                                </Style>
                                                <Style x:Key="{x:Static markdig:Styles.Heading4StyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontSize" Value="16" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Margin" Value="0,4,0,4" />
                                                </Style>

                                                <!-- Code block style -->
                                                <Style x:Key="{x:Static markdig:Styles.CodeBlockStyleKey}" TargetType="{x:Type Paragraph}">
                                                    <Setter Property="Background" Value="#202123"/>
                                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                    <Setter Property="Padding" Value="10"/>
                                                    <Setter Property="Margin" Value="0,10,0,10"/>
                                                </Style>

                                                <!-- Inline code style -->
                                                <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                                    <Setter Property="Background" Value="#202123"/>
                                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                </Style>

                                                <!-- Hyperlink style -->
                                                <Style TargetType="{x:Type Hyperlink}">
                                                    <Setter Property="Foreground" Value="#10A37F" />
                                                    <Setter Property="TextDecorations" Value="None" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="TextDecorations" Value="Underline" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>

                                                <!-- List style (implicit, no keyed style exists in Markdig.Wpf) -->
                                                <Style TargetType="{x:Type List}">
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="Margin" Value="40,0,0,10" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </markdig:MarkdownViewer.Resources>

                                        </markdig:MarkdownViewer> </Grid>

                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMyMessage}" Value="True">
                                            <Setter TargetName="MessageBorder" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="MessageBorder" Property="Background" Value="#10A37F" />
                                            <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToolMessage}" Value="True">
                                            <Setter TargetName="MessageBorder" Property="Background" Value="#2D2D3A" />
                                            <Setter TargetName="MessageBorder" Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter TargetName="MessageBorder" Property="MaxWidth" Value="800" />
                                            <Setter TargetName="Avatar" Property="Background" Value="#D97706" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
    
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="#40414F" CornerRadius="12" Margin="40,0,40,30" MaxWidth="800" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" FontSize="15" Padding="10" 
                                     TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto" CaretBrush="White"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown">
                            </TextBox>

                            <Button Grid.Column="1" 
                                    Command="{Binding SendMessageCommand}"
                                    Background="#10A37F" Foreground="White" BorderThickness="0" Width="35" Height="35"  Margin="5" Cursor="Hand" VerticalAlignment="Bottom">
                                <TextBlock Text="➤" FontSize="16" Margin="2,0,0,0"/>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>