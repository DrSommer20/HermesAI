<Window x:Class="HermesAI.MVVM.View.McpServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="McpWindow"
        Title="MCP Server Verwaltung" Height="550" Width="650"
        Background="#343541" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Dark Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#40414F"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#555566"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style (Green) -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10A37F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D8C6D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button (small, transparent) -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8EA0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2B32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Dark TextBox Style -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#40414F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tborder" Background="#40414F" CornerRadius="4" Padding="8,4">
                                            <Grid>
                                                <ContentPresenter Content="{TemplateBinding Content}" 
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Text="▼" FontSize="10" Foreground="#8E8EA0" 
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tborder" Property="Background" Value="#4A4B5A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="SelectionBoxItem" IsHitTestVisible="False"/>
                            </ToggleButton>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#40414F" CornerRadius="4" 
                                        BorderBrush="#4D4D4F" BorderThickness="1"
                                        Margin="0,2,0,0" Padding="2">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#40414F"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" 
                                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#555566"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#10A37F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BoolToVisibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#4D4D4F" BorderThickness="1" Background="#343541" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════ -->
            <!-- Title Bar -->
            <!-- ═══════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="#202123" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="🔌 MCP Server Verwaltung" Foreground="#D1D5DB" 
                           VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold" FontSize="13"/>
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource CloseButtonStyle}" FontSize="14"
                        Command="{Binding CloseWindowCommand}" CommandParameter="{Binding ElementName=McpWindow}"/>
            </Grid>

            <!-- ═══════════════════════════════════════ -->
            <!-- Main Content: Server list on the left, editor sliding in on the right -->
            <!-- ═══════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ── Server List ── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="15,10">
                        <!-- Empty State Placeholder -->
                        <Grid>
                            <TextBlock Text="Noch keine MCP Server konfiguriert.&#x0a;Klicke auf '+ Server hinzufügen' um loszulegen."
                                       Foreground="#8E8EA0" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Servers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Server Cards -->
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#40414F" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Server Info -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" 
                                                               FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Foreground="#8E8EA0" FontSize="12" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Command, StringFormat='Stdio: {0}'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TransportType}" Value="sse">
                                                                        <Setter Property="Text" Value="{Binding Url, StringFormat='SSE: {0}'}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Margin="0,3,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="✅ Aktiviert"/>
                                                                <Setter Property="Foreground" Value="#10A37F"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Text" Value="⏸ Deaktiviert"/>
                                                                        <Setter Property="Foreground" Value="#8E8EA0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButtonStyle}" Content="✏"
                                                            Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource IconButtonStyle}" Content="🗑" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Margin="2,0,0,0"
                                                            Command="{Binding DataContext.ToggleServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                <Setter Property="Content" Value="⏸"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Content" Value="▶"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15,0,15,15">
                        <Button Content="+ Server hinzufügen" Style="{StaticResource AccentButtonStyle}" Padding="15,8"
                                Command="{Binding AddServerCommand}"/>
                        <Button Content="Schließen" Style="{StaticResource DarkButtonStyle}" Padding="15,8" Margin="10,0,0,0"
                                Command="{Binding CloseWindowCommand}" CommandParameter="{Binding ElementName=McpWindow}"/>
                    </StackPanel>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- Editor Panel (sliding in from the right) -->
                <!-- ═══════════════════════════════════════ -->
                <Border Grid.Column="1" Width="280" Background="#2A2B32" 
                        BorderBrush="#4D4D4F" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- Editor Title -->
                            <TextBlock Text="{Binding EditorTitle}" Foreground="White" 
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <!-- Name -->
                            <TextBlock Text="Name" Foreground="#8E8EA0" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingServer.Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource DarkTextBoxStyle}"/>

                            <!-- Transport -->
                            <TextBlock Text="Transport" Foreground="#8E8EA0" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox SelectedItem="{Binding EditingServer.TransportType}" 
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">stdio</sys:String>
                                <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">sse</sys:String>
                            </ComboBox>

                            <!-- Command (stdio) -->
                            <TextBlock Text="Command (stdio)" Foreground="#8E8EA0" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingServer.Command, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource DarkTextBoxStyle}"/>

                            <!-- Arguments (space-separated) -->
                            <TextBlock Text="Arguments (Leerzeichen-getrennt)" Foreground="#8E8EA0" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingServer.Arguments, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource DarkTextBoxStyle}"/>

                            <!-- URL (sse) -->
                            <TextBlock Text="URL (sse)" Foreground="#8E8EA0" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditingServer.Url, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource DarkTextBoxStyle}"/>

                            <!-- Editor Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button Content="Abbrechen" Style="{StaticResource DarkButtonStyle}" Padding="12,6"
                                        Command="{Binding CancelEditorCommand}"/>
                                <Button Content="Speichern" Style="{StaticResource AccentButtonStyle}" Padding="12,6" Margin="8,0,0,0"
                                        Command="{Binding SaveEditorCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
