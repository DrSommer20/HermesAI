<Window x:Class="HermesAI.MVVM.View.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat umbenennen" Height="150" Width="300"
        Background="#343541" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <Border CornerRadius="8" BorderBrush="#4D4D4F" BorderThickness="1" Background="#343541">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Neuer Titel:" Foreground="#D1D5DB" FontSize="14" Margin="0,0,0,10" Grid.Row="0"/>
            
            <TextBox x:Name="InputTextBox" Grid.Row="1" Background="#40414F" Foreground="White" BorderThickness="0" Padding="5" Height="25"/>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Abbrechen" Background="Transparent" Foreground="#D1D5DB" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click"/>
                <Button Content="Speichern" Background="#10A37F" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
